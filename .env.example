# KOXPilot 模型层配置示例
#
# 复制为 .env 并填入你自己的凭据后使用：
#     cp .env.example .env && source .env
#
# ⚠️ 本项目的语义类推理只在【构建期】运行，产物固化到 output/llm_cache.json。
#    线上 Demo 不调用任何模型 endpoint，因此部署环境不需要配置这些变量。
#
# ⚠️ 仓库中不包含任何真实凭据。请勿把填好的 .env 提交到版本库（已在 .gitignore 中）。

# ── 方案一：任意 OpenAI 兼容服务（推荐，最通用）────────────────────────────
# 适用于 openai.com、vLLM、Ollama、以及大多数自建网关
export OPENAI_API_KEY="sk-your-key-here"
export OPENAI_BASE_URL="https://api.openai.com/v1"
export OPENAI_MODEL="gpt-4o-mini"

# ── 方案二：火山方舟风格 endpoint ──────────────────────────────────────────
# export ARK_API_KEY="your-ark-key"
# export ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# export ARK_MODEL="your-endpoint-id"
# export ARK_THINKING="enabled"           # 推理模式，可选
# export ARK_REASONING_EFFORT="medium"    # low | medium | high，可选

# ── 方案三：Azure OpenAI ──────────────────────────────────────────────────
# export AZURE_OPENAI_API_KEY="your-azure-key"
# export AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
# export AZURE_OPENAI_DEPLOYMENT="your-deployment-name"
# export AZURE_OPENAI_API_VERSION="2024-12-01-preview"
# export AZURE_OPENAI_REASONING_EFFORT="medium"   # 推理型模型可选

# ── 构建期推理的运行方式 ──────────────────────────────────────────────────
#   make llm                                   # 自动探测可用 provider 并跑全部任务
#   python -m koxpilot.llm.runner --models openai --tasks brief,tag,fit
#
# 说明：配置多个 provider 时，runner 会对「标签错配判定」任务用每个模型各跑一遍，
#      在同一份 ground truth 下做横评，用于回答「这个环节值不值得花 token」。
