# ---------------------------------------------------------------------------
# 凭据：绝不入库
# ---------------------------------------------------------------------------
# 仓库里只提供 .env.example 模板。真实的 endpoint 与 API key 只存在于本地 .env。
.env
.env.local
.env.*.local
*.key
*.pem

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# 前端
# ---------------------------------------------------------------------------
web/node_modules/
web/dist/
web/.vite/
web/site.meta
*.tsbuildinfo
.pnpm-store/

# 前端消费的数据是由 scripts/prepare-data.mjs 从 data/ 与 output/ 生成的派生产物，
# 体积大且可一键重建（pnpm run prepare-data），不入库。
web/public/data/

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# 关于 data/ 与 output/ 为什么**入库**
# ---------------------------------------------------------------------------
# 这两个目录是可以由 `make all` 完全确定性重建的（固定种子 SEED=20270919）。
# 之所以仍然提交进仓库：
#   1. 让任何人 clone 之后不跑任何命令就能核对 README 里的每一个数字
#   2. 让 LLM 相关产物（llm_cache / llm_bench / prompt_bench）在没有 API key 的
#      环境下也能被审阅 —— 这些是真实调用的记录，重跑需要凭据且会产生费用
# 唯一例外是本地缓存的中间态，见下：
output/*.tmp
output/*.partial
